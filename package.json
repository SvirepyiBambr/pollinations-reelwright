{
  "name": "reelwright",
  "version": "1.0.0",
  "private": true,
  "description": "Turn a brief into a narrated, captioned mini-documentary with Pollinations and ffmpeg.",
  "license": "MIT",
  "scripts": {
    "demo": "python3 skills/reelwright/scripts/reelwright.py make --brief examples/salt-road/brief.txt --out examples/salt-road --scenes 5 --transcribe",
    "check": "python3 skills/reelwright/scripts/reelwright.py check --project examples/salt-road"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  }
}
